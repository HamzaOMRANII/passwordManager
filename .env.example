NODE_ENV=development
HOST=127.0.0.1
PORT=11000
APP_ORIGIN=https://sec.adviio.com
IT_TOOLS_ORIGIN=https://it-tools.tech
MONGO_URI=mongodb://127.0.0.1:27017/hamza_password_manager
JWT_SECRET=replace-with-at-least-32-random-bytes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=replace-with-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Optional local-development sender (keeps test credentials separate from production)
SMTP_DEV_FROM=you@gmail.com
SMTP_DEV_PASSWORD=replace-with-gmail-app-password
SMTP_DEV_HOST=smtp.gmail.com
SMTP_DEV_PORT=465
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-one-time-password
